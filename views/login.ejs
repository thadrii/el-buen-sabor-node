<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>El Buen Sabor — Acceso del Personal</title>
  <style>
    :root {
      --bg: #f9f8f6;
      --surface: #ffffff;
      --border: #dadde2;
      --border-strong: #c0c3ca;
      --text-high: #0d0d0f;
      --text: #35383f;
      --text-muted: #626976;
      --accent: #c2410c;
      --accent-hover: #9a3412;
      --error: #bf000f;
      --error-bg: #fff2f2;
      --ok: #059669;
      --ok-bg: #ecfdf5;
      --sh-zed: 6px 6px 0 rgba(194, 65, 12, 0.06), -6px -6px 0 rgba(194, 65, 12, 0.035);
      --serif: "IBM Plex Serif", Georgia, serif;
      --mono: ui-monospace, SFMono-Regular, "Cascadia Code", Menlo, Consolas, monospace;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      color: var(--text);
      font-family: var(--mono);
      letter-spacing: -0.015em;
      padding: 16px;
    }
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      background-image:
        linear-gradient(to right, rgba(194, 65, 12, 0.035) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(194, 65, 12, 0.035) 1px, transparent 1px);
      background-size: 12px 12px;
      z-index: 0;
    }
    .caja {
      position: relative;
      z-index: 1;
      width: 100%;
      max-width: 420px;
      background: var(--surface);
      padding: 32px 30px 26px;
      border: 1px solid var(--border);
      border-radius: 4px;
      box-shadow: var(--sh-zed);
    }
    .brand-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 18px;
      font-size: 11px;
      color: var(--text-muted);
    }
    .brand-bar a { color: var(--accent); text-decoration: none; font-weight: 600; }
    h1 {
      margin: 0 0 6px;
      font-family: var(--serif);
      font-size: 22px;
      color: var(--text-high);
    }
    .sub {
      margin: 0 0 20px;
      font-size: 12px;
      color: var(--text-muted);
    }
    label {
      display: block;
      font-size: 11px;
      font-weight: 600;
      margin-bottom: 6px;
      color: var(--text-high);
    }
    input {
      width: 100%;
      padding: 10px 12px;
      margin-bottom: 14px;
      border: 1px solid var(--border-strong);
      border-radius: 4px;
      font-family: var(--mono);
      font-size: 13px;
      background: #fff;
      color: var(--text-high);
    }
    input:focus { outline: 2px solid rgba(194, 65, 12, 0.25); border-color: var(--accent); }
    button[type="submit"] {
      width: 100%;
      padding: 11px;
      border: none;
      border-radius: 4px;
      background: var(--accent);
      color: #fff;
      font-family: var(--mono);
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
    }
    button[type="submit"]:hover { background: var(--accent-hover); }
    .msg {
      display: none;
      margin-top: 12px;
      padding: 10px 12px;
      border-radius: 4px;
      font-size: 12px;
    }
    .msg.error { display: block; background: var(--error-bg); color: var(--error); border: 1px solid #fecaca; }
    .msg.ok { display: block; background: var(--ok-bg); color: var(--ok); border: 1px solid #a7f3d0; }
    .demo-box {
      margin-top: 20px;
      padding-top: 16px;
      border-top: 1px dashed var(--border);
    }
    .demo-title {
      font-size: 11px;
      color: var(--text-muted);
      margin-bottom: 8px;
    }
    .demo-btns {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 6px;
    }
    .demo-btn {
      padding: 7px 6px;
      border: 1px solid var(--border-strong);
      background: #faf9f7;
      border-radius: 4px;
      font-family: var(--mono);
      font-size: 11px;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-high);
    }
    .demo-btn:hover { border-color: var(--accent); color: var(--accent); }
  </style>
</head>
<body>
  <div class="caja">
    <div class="brand-bar">
      <span>EL BUEN SABOR · JWT AUTH</span>
      <a href="/">&larr; Volver al salón</a>
    </div>
    <h1>Ingreso de Personal</h1>
    <p class="sub">Cocina, Mozo y Administración en tiempo real.</p>

    <form id="loginForm">
      <label for="email">Correo institucional</label>
      <input id="email" type="email" required placeholder="cocina@buensabor.pe" autocomplete="email">

      <label for="password">Contraseña</label>
      <input id="password" type="password" required placeholder="•••••" autocomplete="current-password">

      <button type="submit">Ingresar al sistema</button>
    </form>

    <div id="feedback" class="msg"></div>

    <div class="demo-box">
      <div class="demo-title">Accesos rápidos de prueba (clave: 12345)</div>
      <div class="demo-btns">
        <button type="button" class="demo-btn" onclick="fillDemo('cocina@buensabor.pe')">Cocinero</button>
        <button type="button" class="demo-btn" onclick="fillDemo('mozo@buensabor.pe')">Mozo</button>
        <button type="button" class="demo-btn" onclick="fillDemo('admin@buensabor.pe')">Admin</button>
      </div>
    </div>
  </div>

  <script>
    function fillDemo(email) {
      document.getElementById('email').value = email
      document.getElementById('password').value = '12345'
    }

    function routeByRole(rol) {
      if (rol === 'cocinero') return '/cocina'
      if (rol === 'mozo') return '/mozo'
      return '/dashboard'
    }

    document.getElementById('loginForm').addEventListener('submit', async (e) => {
      e.preventDefault()
      const feedback = document.getElementById('feedback')
      feedback.className = 'msg'
      feedback.textContent = ''

      const email = document.getElementById('email').value.trim()
      const password = document.getElementById('password').value

      try {
        const res = await fetch('/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        })
        const data = await res.json()
        if (!res.ok) {
          feedback.className = 'msg error'
          feedback.textContent = data.message || 'Error al iniciar sesión'
          return
        }

        localStorage.setItem('token', data.token)
        localStorage.setItem('user', JSON.stringify(data.user))
        feedback.className = 'msg ok'
        feedback.textContent = `Bienvenido ${data.user.nombre} (${data.user.rol}). Redirigiendo...`
        setTimeout(() => {
          window.location.href = routeByRole(data.user.rol)
        }, 400)
      } catch (err) {
        feedback.className = 'msg error'
        feedback.textContent = 'No se pudo conectar con el servidor'
      }
    })
  </script>
</body>
</html>
